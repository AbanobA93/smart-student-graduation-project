{
  "info": {
    "_postman_id": "8e44b190-5591-4a7b-9d32-019283746501",
    "name": "Smart Student Management System — Graduation Project API",
    "description": "Complete Postman Collection for the Smart Student Management System Web API (.NET 10 LTS). Includes automatic JWT token capture on Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://localhost:7145", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{jwt_token}}", "type": "string" }
    ]
  },
  "item": [
    {
      "name": "1. Auth & Domain Portals",
      "item": [
        {
          "name": "Login — Admin Domain Portal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login/admin",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@smartstudent.edu\",\n  \"password\": \"Admin@12345\"\n}"
            }
          }
        },
        {
          "name": "Login — Teacher Domain Portal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login/teacher",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher1@smartstudent.edu\",\n  \"password\": \"Teacher@12345\"\n}"
            }
          }
        },
        {
          "name": "Login — Student Domain Portal",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res && res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set('jwt_token', res.data.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/login/student",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student1@smartstudent.edu\",\n  \"password\": \"Student@12345\"\n}"
            }
          }
        },
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/auth/register/student",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Hassan\",\n  \"email\": \"student1@smartstudent.edu\",\n  \"password\": \"Student@12345\",\n  \"studentNumber\": \"STU-2026-001\",\n  \"dateOfBirth\": \"2005-05-15\",\n  \"gender\": 1,\n  \"address\": \"Cairo, Egypt\",\n  \"classRoomId\": null\n}"
            }
          }
        },
        {
          "name": "Register Teacher (Admin Only)",
          "request": {
            "method": "POST",
