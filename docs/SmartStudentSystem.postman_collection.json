              "raw": "{\n  \"name\": \"Grade 12 - Class A\",\n  \"gradeLevel\": 12,\n  \"capacity\": 35,\n  \"academicYear\": 2026\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Students & Enrollment",
      "item": [
        {
          "name": "Get Paginated Students",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/Students?PageNumber=1&PageSize=10" }
        },
        {
          "name": "Assign Student to ClassRoom (Admin)",
          "request": {
