              "raw": "{\n  \"fullName\": \"Dr. Mohamed Ali\",\n  \"email\": \"teacher1@smartstudent.edu\",\n  \"password\": \"Teacher@12345\",\n  \"employeeNumber\": \"TCH-2026-001\",\n  \"department\": \"Computer Science\",\n  \"specialization\": \"Software Engineering\",\n  \"hireDate\": \"2024-09-01\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "2. ClassRooms",
      "item": [
        {
          "name": "Get All ClassRooms",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/ClassRooms" }
        },
        {
          "name": "Create ClassRoom (Admin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/ClassRooms",
            "body": {
